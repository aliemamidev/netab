{
  "name": "netab",
  "version": "3.0.0",
  "private": false,
  "description": "Private all-in-one Chrome new tab: smart search & command palette, Pomodoro with site blocking, tab manager, tasks, notes, weather, Jalali calendar.",
  "type": "module",
  "scripts": {
    "test": "node scripts/validate.mjs && node --test tests/unit.test.mjs tests/i18n.test.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "validate": "node scripts/validate.mjs",
    "lint": "npx --yes eslint@10 src scripts tests",
    "icons": "node scripts/render-icons.mjs",
    "sync:env": "node scripts/sync-env.mjs",
    "zip": "node scripts/zip-release.mjs"
  },
  "keywords": [
    "chrome-extension",
    "new-tab",
    "dashboard",
    "productivity",
    "pomodoro",
    "tab-manager",
    "command-palette",
    "jalali-calendar",
    "persian",
    "quick-links"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
