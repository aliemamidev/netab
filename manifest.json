{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "NeTab",
  "version": "3.0.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "chrome_url_overrides": {
    "newtab": "src/newtab/newtab.html"
  },
  "action": {
    "default_title": "NeTab",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "favicon",
    "activeTab",
    "alarms",
    "notifications",
    "contextMenus",
    "sidePanel",
    "offscreen",
    "tabs",
    "tabGroups",
    "search",
    "system.cpu",
    "system.memory"
  ],
  "optional_permissions": [
    "bookmarks",
    "history",
    "topSites"
  ],
  "optional_host_permissions": [
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://api.coingecko.com/*",
    "https://open.er-api.com/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+N"
      },
      "description": "Open the NeTab popup"
    },
    "toggle-focus": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Start / pause the focus timer"
    },
    "read-later": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Save the current page to Read later"
    },
    "open-side-panel": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Open the NeTab side panel"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: blob:; media-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://api.open-meteo.com https://geocoding-api.open-meteo.com https://api.coingecko.com https://open.er-api.com;"
  }
}
